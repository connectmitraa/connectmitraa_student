# ConnectMitraa Configuration
# Zero external API keys needed - 100% self-hosted & high-concurrency real-time architecture

VITE_APP_NAME=ConnectMitraa
VITE_API_URL=http://localhost:8080
VITE_WS_URL=ws://localhost:8080/ws/signaling

# Multi-STUN Google Cloud Cluster (Failover Redundancy)
VITE_STUN_SERVER=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302,stun:stun2.l.google.com:19302,stun:stun3.l.google.com:19302

# Server Port Settings
PORT=3000
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# High Concurrency Max Participants Configuration
VITE_MAX_ROOM_CAPACITY=500
VITE_ENABLE_VIRTUAL_THREADS=true

# Optional Supabase Realtime & Auth Integration
# If set, Admin Portal authenticates against your Supabase project. Otherwise, local admin verification is active.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Admin Portal Security Route (Secret URL Obfuscation)
# Change this secret slug anytime to prevent automated crawler/hacker discovery
VITE_ADMIN_SECRET_PATH=/connectmitraa-admin
